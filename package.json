{
  "name": "fern",
  "version": "0.1.36",
  "private": true,
  "description": "Fern local-first desktop studio for OpenVINO image, text, and audio models",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fern/desktop",
    "start": "npm run start --workspace @fern/desktop",
    "build": "npm run build --workspace @fern/desktop",
    "typecheck": "npm run typecheck --workspace @fern/desktop",
    "check:python": "python -m compileall -q scripts",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:ui": "node scripts/test-renderer.mjs",
    "check": "npm run typecheck && npm run check:python && npm run test:python && npm run build",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
