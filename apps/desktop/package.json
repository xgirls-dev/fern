{
  "name": "@fern/desktop",
  "version": "0.1.29",
  "private": true,
  "description": "Fern local-first desktop studio for OpenVINO image, text, and audio models",
  "author": "Fern",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:browser-test": "vite build --config vite.browser-test.config.mjs --configLoader native",
    "preview:browser-test": "vite preview --config vite.browser-test.config.mjs --configLoader native --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node scripts/start.mjs",
    "test:electron": "npm run build && node e2e/smoke.mjs",
    "build": "electron-vite build",
    "preview": "cross-env ELECTRON_RUN_AS_NODE= electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "ai.intel-iris.studio",
    "productName": "Fern",
    "compression": "normal",
    "copyright": "Copyright (c) 2026",
    "asar": true,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "extraResources": [
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": [
          "*.txt"
        ]
      },
      {
        "from": "resources/runtime-release.json",
        "to": "runtime-release.json"
      },
      {
        "from": "resources/runtime-release.zip",
        "to": "runtime-release.zip"
      },
      {
        "from": "resources/scripts",
        "to": "scripts"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Fern-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fern",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    }
  }
}
